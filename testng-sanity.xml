<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- SANITY suite: runs only tests tagged @Test(groups = {"sanity"}).
     To add a case to sanity, add groups = {"sanity"} to its @Test annotation.
     Full regression is testng.xml. -->
<suite name="CheckmarxOneSanity"
       verbose="1"
       parallel="false">

    <listeners>
        <listener class-name="utils.ExcelReportListener"/>
    </listeners>

    <test name="Sanity" preserve-order="true" parallel="false">
        <parameter name="cases.group" value="sanity"/>
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <classes>
            <class name="com.myorg.cxone.tests.ConfigureTest"/>
            <class name="com.myorg.cxone.tests.AuthTest"/>
            <class name="com.myorg.cxone.tests.HelpTest"/>
            <class name="com.myorg.cxone.tests.CliCommandTest"/>
            <class name="com.myorg.cxone.tests.SuiteQualityTest"/>
            <class name="com.myorg.cxone.tests.scanTestDataDriven"/>
        </classes>
    </test>
</suite>
